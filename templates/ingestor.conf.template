# Cloud-side Log Ingestor (Fluent Bit aggregator) — the only cloud log-shipping
# path on the edge now that the direct Loki sink has been removed from
# fluent-bit.conf. Rendered by setup.sh from this template
# only when the Hub /api/edge/installer/v1/observability response provides both
# `log_ingest_endpoint` and `log_ingest_api_token`. Otherwise setup.sh writes
# an empty placeholder so the @INCLUDE in fluent-bit.conf still resolves.
#
# Wire / auth contract:
#   - Edge ships the structured records verbatim as a JSON array (`Format
#     json`) to an API Gateway that performs native API Key auth on the
#     `x-api-key` header. The org identity is derived server-side from the
#     key, and the body passes through unmodified.
#   - Because the body is not reshaped, every field — `level` / `run_id` /
#     `supervisor_id` / `trace_id` / the free-form `app.details` — reaches the
#     backend intact. Edge does NOT pre-shape records and does NOT inject
#     `env`/`job`; those are owned server-side, so forgery is not possible.

[OUTPUT]
    Name              http
    Match             agenticsec.*
    Host              {{LOG_INGEST_HOST}}
    Port              443
    URI               {{LOG_INGEST_URI}}
    TLS               On
    TLS.verify        On
    Format            json
    # Records already carry `@timestamp`; disable the redundant epoch `date`
    # key the http output would otherwise inject.
    json_date_key     false
    Header            x-api-key {{LOG_INGEST_API_TOKEN}}
    storage.total_limit_size 1G
    Retry_Limit       no_limits
    net.dns.mode        UDP
    net.dns.resolver    LEGACY
    net.dns.prefer_ipv4 true
