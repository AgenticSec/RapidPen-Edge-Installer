[SERVICE]
    Flush        5
    Daemon       Off
    Log_Level    info
    Parsers_File /fluent-bit/etc/parsers.conf
    Hot_Reload   On
    storage.path /fluent-bit/data/storage
    storage.sync normal
    storage.backlog.mem_limit 64M

# Supervisor logs
[INPUT]
    Name              tail
    Path              /var/log/agenticsec/supervisor/*.jsonl
    Parser            json
    Tag               agenticsec.supervisor
    Refresh_Interval  5
    Mem_Buf_Limit     5MB
    Skip_Long_Lines   On
    Read_from_Head    False
    DB                /fluent-bit/data/supervisor.db
    Rotate_Wait       5
    storage.type      filesystem

# Operator logs
[INPUT]
    Name              tail
    Path              /var/log/agenticsec/operator/*/*.jsonl
    Parser            json
    Tag               agenticsec.operator
    Refresh_Interval  5
    Mem_Buf_Limit     5MB
    Skip_Long_Lines   On
    Read_from_Head    False
    DB                /fluent-bit/data/operator.db
    Rotate_Wait       5
    storage.type      filesystem

# Cloud-side Log Ingestor — generated by setup.sh.
# Empty (comment-only) when Hub returns no log_ingest_endpoint.
@INCLUDE /fluent-bit/etc/ingestor.conf
