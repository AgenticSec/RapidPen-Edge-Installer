#!/usr/bin/expect -f
# 実端末（pty）を与えた状態でインストーラを動かし、期待どおりに振る舞うかを見る。
#
#   argv0: ケース名  argv1: テスト用イメージ  argv2: リポジトリのルート
#
# このインストーラは対話入力を行わないが、利用者は端末のある環境で実行する。
# 端末があっても入力待ちに落ちない（＝ハングしない）ことの確認が主眼。
# 端末を必要としないケースは run.sh 側で扱う。

set case_name [lindex $argv 0]
set image     [lindex $argv 1]
set repo_root [lindex $argv 2]

proc verdict {status message} {
    puts "\n>>> $status: $message"
    if {$status eq "PASS"} { exit 0 }
    exit 1
}

# 設定不足で止まるケースは即座に終わるはずなので短く、
# 最後まで進むケースは GitHub Release の取得などがあるので長めに取る。
switch -- $case_name {
    "missing-api-key" { set timeout 30 }
    default           { set timeout 120 }
}

spawn docker run --rm -i -t -v $repo_root:/src:ro $image sh /src/tests/case.sh $case_name

switch -- $case_name {
    "with-env" {
        # 端末があっても入力を求めず、設定が保存されること
        expect {
            "API Key: "  { verdict FAIL "対話入力を求めてしまった" }
            "Base URL: " { verdict FAIL "対話入力を求めてしまった" }
            -re {STORED_API_KEY\[([^\]]*)\]} {
                set stored $expect_out(1,string)
                if {$stored eq "testkey123"} {
                    verdict PASS "無入力で進み、API キーが保存された"
                }
                verdict FAIL "保存された API キーが違う: \[$stored\]"
            }
            "STATE_FILE_MISSING" { verdict FAIL "state.json が生成されなかった" }
            timeout { verdict FAIL "完了しない（ハング）" }
            eof     { verdict FAIL "途中で終了した" }
        }
    }

    "missing-api-key" {
        # 端末があっても入力待ちに落ちず、案内を出して終了すること。
        # 旧実装はここで永久に待ち続けていた。
        expect {
            "API Key: " { verdict FAIL "対話入力を求めてしまった（ハングの原因）" }
            "AGENTICSEC_API_KEY is not set" {}
            timeout { verdict FAIL "設定不足なのに終了しない（ハング）" }
            eof     { verdict FAIL "案内を出さずに終了した" }
        }
        expect {
            "Pentest Edge" { verdict PASS "案内を出して終了した" }
            timeout { verdict FAIL "案内の途中で停止した" }
            eof     { verdict FAIL "Web UI への導線が案内されなかった" }
        }
    }

    default {
        verdict FAIL "expect ドライバが扱わないケース: $case_name"
    }
}
